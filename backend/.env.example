# Copy to .env for local development. NEVER commit .env.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# REQUIRED in production (min 32 random characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to use an ephemeral secret.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
JWT_ISSUER=skyntri-api
JWT_AUDIENCE=skyntri-web

# Comma-separated e-mails that receive the server-side admin role.
ADMIN_EMAILS=

# SQLite for local development. Production: managed PostgreSQL, e.g.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/skyntri
DATABASE_URL=sqlite:///./skyntri.db
# Run Alembic migrations at start-up (dev). In Docker the entrypoint runs them.
AUTO_MIGRATE=true

# Frontend origin(s) allowed to call the API. No "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Private storage for images/reports (never publicly served).
# Production: absolute path on a persistent private volume, e.g. /data/uploads
UPLOAD_DIR=uploads
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=10485760

# Password-reset e-mail (required for password reset in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_MINUTES=30

# Rate limits (database-backed, shared across workers)
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Model A (facial concerns) + optional trained skin/non-skin gate
DATASET3_MODEL_PATH=models/EfficientNetB0_weighted_focal_finetuned_best.keras
SKIN_GATE_MODEL_PATH=models/skin_gate.keras
MAX_CONCURRENT_INFERENCE=2
MODEL_WARMUP=false

# Optional LLM integration (local fallback is always available)
LLM_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_MAX_OUTPUT_TOKENS=700
