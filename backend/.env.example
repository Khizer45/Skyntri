# Copy this file to .env and adjust values before running the server.

# Used to sign JWT access tokens. Generate a real random value for production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-long-random-secret

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# SQLite by default for local development. Swap for a PostgreSQL URL in
# production, e.g. postgresql://user:password@localhost:5432/skyntri
DATABASE_URL=sqlite:///./skyntri.db

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base directory (relative to app/) where uploaded images and generated
# reports are stored.
UPLOAD_DIR=uploads

# Optional LLM integration
# OpenAI is the primary provider; Gemini can be used as fallback.
LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=//
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=//
GEMINI_MODEL=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=700
