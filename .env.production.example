# Copy to ".env" on the server (next to docker-compose.prod.yml). Never commit .env.
# Generate random values with:  openssl rand -hex 32

# Two names that point to this server's IP address (DNS "A" records).
# No domain yet? Free sslip.io names work: write the server IP with dashes, for
# example skyntri.203-0-113-5.sslip.io for the site and api.203-0-113-5.sslip.io
# for the backend.
SITE_DOMAIN=skyntri.example.com
API_DOMAIN=api.skyntri.example.com

# Your e-mail gets the admin role when you sign up on the live site.
ADMIN_EMAILS=you@example.com

# At least 32 random characters (openssl rand -hex 32).
SECRET_KEY=

# Database password: letters and digits only (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Optional: e-mail for "forgot password" (for Gmail use an App Password).
# Without SMTP, password reset stays switched off in production.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Skyntri <you@gmail.com>

# Switch on only after the disease model has been trained and reviewed.
# DISEASE_SCREENING_ENABLED=false
