# Copy to ".env" (same folder as docker-compose.yml) and fill in. Never commit .env.

# Your e-mail gets the admin role (Manage Products / Manage Orders) when you sign up.
ADMIN_EMAILS=you@example.com

# Keeps you logged in across restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# or any long random string (at least 32 characters).
SECRET_KEY=

# PostgreSQL password used by the "db" service (change it; set it BEFORE the first start)
POSTGRES_PASSWORD=change-me-to-a-long-password

# Trained models (put the files in backend/models/ first)
# Default model file names are already set; only change these if you rename files.
# DATASET3_MODEL_PATH=models/facial_concerns_efficientnet.keras
# FACIAL_MODEL_METADATA_PATH=models/facial_concerns_metadata.json
# DISEASE_SCREENING_ENABLED=false

# ---------------------------------------------------------------------------
# Optional connections. Leave empty to keep the feature off.
# Step-by-step setup for each one: docs/INTEGRATIONS.md
# ---------------------------------------------------------------------------

# Sign in with Google (free). OAuth "Web application" client ID.
GOOGLE_CLIENT_ID=

# Assistant answers from Google Gemini (free tier available).
LLM_ENABLED=false
GEMINI_API_KEY=
# Illustrations in the assistant (billed per image by the provider).
LLM_IMAGE_ENABLED=false

# Card payments through Stripe. Use sk_test_... keys while testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal. "sandbox" takes no real money; "live" does.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# PayPal cannot charge PKR: shop prices are divided by this rate and charged in PAYPAL_CURRENCY.
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=0

# Clinic
CLINIC_NAME=Skyntri Clinic
CLINIC_TIMEZONE=Asia/Karachi

# Built-in agents (daily report, reminders, daily post) run by the API itself.
# Leave false when n8n starts them (automation/n8n/skyntri-daily-agents.json).
AGENTS_SCHEDULER_ENABLED=false

