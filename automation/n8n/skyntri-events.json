      "id": "a1f0c7d2-0001-4a10-9c01-000000000001",
      "name": "Skyntri webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "skyntri-events"
    },
    {
      "parameters": {
        "jsCode": "// 1. Paste the signing secret of this webhook (Skyntri: Admin > Automation > Webhooks).\nconst SECRET = 'PASTE_SIGNING_SECRET_HERE';\n\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst timestamp = String(headers['x-skyntri-timestamp'] || '');\nconst received = String(headers['x-skyntri-signature'] || '');\n\n// The signature covers the exact bytes Skyntri sent.\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = 'sha256=' + crypto.createHmac('sha256', SECRET).update(timestamp + '.').update(raw).digest('hex');\n\nconst a = Buffer.from(expected);\nconst b = Buffer.from(received);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error('Signature check failed: this request did not come from Skyntri.');\n}\n// Refuse old messages (replay protection): 5 minutes.\nif (Math.abs(Date.now() / 1000 - Number(timestamp)) > 300) {\n  throw new Error('The message is too old.');\n}\n\nconst message = JSON.parse(raw.toString('utf8'));\nreturn [{ json: { event: message.event, id: message.id, created_at: message.created_at, ...message.data } }];"
      },
      "id": "a1f0c7d2-0002-4a10-9c01-000000000002",
      "name": "Check signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
