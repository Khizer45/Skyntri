# Copy to .env for local development. NEVER commit .env.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# REQUIRED in production (min 32 random characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to use an ephemeral secret.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
JWT_ISSUER=skyntri-api
JWT_AUDIENCE=skyntri-web

# Comma-separated e-mails that receive the server-side admin role.
ADMIN_EMAILS=

# SQLite for local development. Production: managed PostgreSQL, e.g.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/skyntri
DATABASE_URL=sqlite:///./skyntri.db
# Run Alembic migrations at start-up (dev). In Docker the entrypoint runs them.
AUTO_MIGRATE=true

# Frontend origin(s) allowed to call the API. No "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Private storage for images/reports (never publicly served).
# Production: absolute path on a persistent private volume, e.g. /data/uploads
UPLOAD_DIR=uploads
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=10485760

# Password-reset e-mail (required for password reset in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_MINUTES=30

# Rate limits (database-backed, shared across workers)
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Model A (facial concerns). Train it with
# ml/notebooks/01_facial_skin_concerns_efficientnet.ipynb and copy the two
# exported files into backend/models/ (these are the default names):
DATASET3_MODEL_PATH=models/facial_concerns_efficientnet.keras
FACIAL_MODEL_METADATA_PATH=models/facial_concerns_metadata.json

# Model B (skin disease screening support, face + body), exported by
# ml/notebooks/02_skin_disease_screening_efficientnet.ipynb.
# Keep DISABLED until a dermatologist has reviewed the evaluation.
DISEASE_SCREENING_ENABLED=false
DISEASE_MODEL_PATH=models/skin_disease_efficientnet.keras
DISEASE_MODEL_METADATA_PATH=models/skin_disease_metadata.json

# Optional trained skin/non-skin gate
SKIN_GATE_MODEL_PATH=models/skin_gate.keras
MAX_CONCURRENT_INFERENCE=2
MODEL_WARMUP=false

# Shop
SHOP_CURRENCY=PKR
PRICE_STALE_AFTER_DAYS=30
ORDER_PER_HOUR=20
MAX_CART_QUANTITY=10

# Optional LLM integration (local fallback is always available)
LLM_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# A text model that Google has retired is replaced automatically.
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# Wanted size of one answer (an allowance for the model's thinking is added).
LLM_MAX_OUTPUT_TOKENS=1500
# Illustrations in the assistant (billed per image by the provider)
LLM_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-2

# Sign in with Google (OAuth "Web application" client ID)
GOOGLE_CLIENT_ID=

# Clinic
CLINIC_NAME=Skyntri Clinic
CLINIC_TIMEZONE=Asia/Karachi
APPOINTMENT_MIN_NOTICE_MINUTES=60
APPOINTMENT_MAX_DAYS_AHEAD=60

# Online payments (docs/INTEGRATIONS.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=0

# Automation (n8n, Zapier, agents)
AUTOMATION_ALLOWED_HOSTS=
AGENTS_SCHEDULER_ENABLED=false
AGENT_DAILY_HOUR=8
AGENT_POSTS_AUTO_PUBLISH=false

